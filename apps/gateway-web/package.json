    "prepopulate": "npm run fixtures:generate && node e2e/fixtures/prepopulate.mjs"
  },
  "dependencies": {
    "next": "15.5.24",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.51.1",
    "@types/node": "20.14.12",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "axe-core": "4.10.2",
    "eslint": "8.57.0",
    "eslint-config-next": "15.5.24",
    "jsdom": "25.0.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "typescript": "5.5.4",
    "vitest": "2.1.9"
  }
}
