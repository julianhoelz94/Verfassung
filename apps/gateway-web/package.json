{
  "name": "gateway-web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint app lib proxy.ts --max-warnings=0",
    "test": "node --test lib/interpret-me.test.cjs e2e/fixtures/prepopulate-import.test.mjs e2e/fixtures/prepopulate-access.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config=playwright.full.config.js",
    "fixtures:generate": "node e2e/fixtures/generate.mjs",
    "prepopulate": "npm run fixtures:generate && node e2e/fixtures/prepopulate.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@testing-library/dom": "10.4.2",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.10.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "25.0.1",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "typescript": "5.5.4",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
