{
  "name": "gateway-web",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "test": "node --test lib/interpret-me.test.cjs e2e/fixtures/prepopulate-import.test.mjs && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:full": "playwright test --config=playwright.full.config.js",
