PROFILE=ci
CADDY_EXPOSE_API_DOCS=true
CI_BOT_EMAIL=ci-bot@example.local
CI_BOT_PASSWORD=change-me
CI_EDITOR_EMAIL=ci-editor@example.local
CI_EDITOR_PASSWORD=change-me
CI_REVIEWER_EMAIL=ci-reviewer@example.local
CI_REVIEWER_PASSWORD=change-me
CI_PUBLISHER_EMAIL=ci-publisher@example.local
CI_PUBLISHER_PASSWORD=change-me
CI_ADMIN_EMAIL=ci-admin@example.local
CI_ADMIN_PASSWORD=change-me
CI_VIEWER_EMAIL=ci-viewer@example.local
CI_VIEWER_PASSWORD=change-me
IDENTITY_SEED_MODE=create-only
IDENTITY_SESSION_IDLE=30m
IDENTITY_SESSION_ABSOLUTE=12h
IDENTITY_SEED_TOTP_SECRET=CAATLASMFASEED22
IDENTITY_MFA_ENCRYPTION_KEY=ci-mfa-dev-key
SESSION_COOKIE_SECURE=true
NEXT_PUBLIC_BASE_URL=https://tst.verfassungen.de
PUBLIC_BASE_URL=https://tst.verfassungen.de

IDENTITY_SEED_SERVICE_TOKEN=ci-service-token-change-me
IDENTITY_SEED_INGESTION_PUBLISH_TOKEN=ci-ingestion-publish-token-change-me
INGESTION_PUBLISH_TOKEN=ci-ingestion-publish-token-change-me
IDENTITY_SEED_INGESTION_AUDIT_TOKEN=ci-ingestion-audit-token-change-me
INGESTION_AUDIT_TOKEN=ci-ingestion-audit-token-change-me
IDENTITY_SEED_INGESTION_SEARCH_TOKEN=ci-ingestion-search-token-change-me
INGESTION_SEARCH_TOKEN=ci-ingestion-search-token-change-me
AUDIT_API_BEARER=ci-service-token-change-me
EDITOR_SERVICE_TOKEN=ci-service-token-change-me

# Local transport exception; production rejects this mode.
TLS_MODE=local-http
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTPS_PORT=443

# Explicit development fixture completion; forbidden in production.
SETUP_FIXTURE_COMPLETE=true

# OPTIONAL at deployment: configure these later in setup/admin settings.
# Nonblank values override saved settings and are marked deployment-managed.
SITE_LANGUAGES=
SITE_DEFAULT_LANGUAGE=
SITE_REGISTRATION_ENABLED=
SMTP_ENABLED=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
SMTP_SSL=
# OPTIONAL at deployment, REQUIRED before completing first setup.
# Actual details must be reviewed and published; environment values prefill drafts.
IMPRINT_NAME=
IMPRINT_STREET_ADDRESS=
IMPRINT_POSTAL_CODE=
IMPRINT_CITY=
IMPRINT_COUNTRY=
IMPRINT_EMAIL=
