PROFILE=ci
CADDY_EXPOSE_API_DOCS=true
CI_BOT_EMAIL=ci-bot@example.local
CI_BOT_PASSWORD=change-me
CI_EDITOR_EMAIL=ci-editor@example.local
CI_EDITOR_PASSWORD=change-me
CI_REVIEWER_EMAIL=ci-reviewer@example.local
CI_REVIEWER_PASSWORD=change-me
CI_PUBLISHER_EMAIL=ci-publisher@example.local
CI_PUBLISHER_PASSWORD=change-me
CI_ADMIN_EMAIL=ci-admin@example.local
CI_ADMIN_PASSWORD=change-me
CI_VIEWER_EMAIL=ci-viewer@example.local
CI_VIEWER_PASSWORD=change-me
IDENTITY_SEED_MODE=create-only
IDENTITY_SESSION_IDLE=30m
IDENTITY_SESSION_ABSOLUTE=12h
IDENTITY_SEED_TOTP_SECRET=CAATLASMFASEED22
IDENTITY_MFA_ENCRYPTION_KEY=ci-mfa-dev-key
SESSION_COOKIE_SECURE=true
NEXT_PUBLIC_BASE_URL=https://tst.verfassungen.de
PUBLIC_BASE_URL=https://tst.verfassungen.de

# Optional. CI does not send mail unless SMTP_HOST and IDENTITY_MAIL_FROM are set.
IDENTITY_MAIL_ENABLED=true
IDENTITY_MAIL_FROM=
IDENTITY_MAIL_FROM_NAME=Constitution Atlas
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
IDENTITY_SEED_SERVICE_TOKEN=ci-service-token-change-me
AUDIT_API_BEARER=ci-service-token-change-me
EDITOR_SERVICE_TOKEN=ci-service-token-change-me
