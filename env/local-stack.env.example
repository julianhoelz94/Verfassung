PROFILE=local-stack
GATEWAY_PORT=3000
CADDY_PORT=80
CADDY_EXPOSE_API_DOCS=true
PUBLIC_BASE_URL=http://localhost

IDENTITY_SEED_MODE=create-only
IDENTITY_SESSION_IDLE=30m
IDENTITY_SESSION_ABSOLUTE=24h
IDENTITY_SEED_TOTP_SECRET=CAATLASMFASEED22
IDENTITY_MFA_ENCRYPTION_KEY=local-mfa-dev-key
SESSION_COOKIE_SECURE=false

LOCAL_ADMIN_EMAIL=local-admin@example.local
LOCAL_ADMIN_PASSWORD=change-me
LOCAL_EDITOR_EMAIL=local-editor@example.local
LOCAL_EDITOR_PASSWORD=change-me
LOCAL_REVIEWER_EMAIL=local-reviewer@example.local
LOCAL_REVIEWER_PASSWORD=change-me
LOCAL_PUBLISHER_EMAIL=local-publisher@example.local
LOCAL_PUBLISHER_PASSWORD=change-me
LOCAL_VIEWER_EMAIL=local-viewer@example.local
LOCAL_VIEWER_PASSWORD=change-me

# Machine token for catalog/content/search/audit/ingestion writes (IDN-14).
# Same plaintext is hashed at rest in identity and sent as Bearer by editor/audit.
IDENTITY_SEED_SERVICE_TOKEN=local-stack-service-token-change-me
AUDIT_API_BEARER=local-stack-service-token-change-me
EDITOR_SERVICE_TOKEN=local-stack-service-token-change-me
