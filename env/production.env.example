PROFILE=production
CADDY_EXPOSE_API_DOCS=true
SESSION_COOKIE_SECURE=true
IDENTITY_SEED_MODE=off
IDENTITY_SESSION_IDLE=15m
IDENTITY_SESSION_ABSOLUTE=12h
# Must be 32-byte base64 (`openssl rand -base64 32`). ProductionIdentityGuard rejects
# blank values, `local-mfa-dev-key`, and passphrase-derived keys.
IDENTITY_MFA_ENCRYPTION_KEY=

# Must be set: shared superuser password for the eight per-service Postgres
# databases and the backup job. docker-compose.yml falls back to `postgres`.
POSTGRES_PASSWORD=
AUDIT_RUNTIME_PASSWORD=
# Days of dump directories kept under ./backups (0 keeps all).
BACKUP_RETENTION_DAYS=30

# Required for the first installation: PROD_ADMIN_EMAIL and a strong PROD_ADMIN_PASSWORD.
# The bootstrap path creates this account once; demo seeding remains disabled.
# Other role credentials are unused in production; leave blank. ProductionIdentityGuard rejects
# example.local emails and demo passwords (change-me, use-secret-store).
PROD_ADMIN_EMAIL=
PROD_ADMIN_PASSWORD=
PROD_EDITOR_EMAIL=
PROD_EDITOR_PASSWORD=
PROD_REVIEWER_EMAIL=
PROD_REVIEWER_PASSWORD=
PROD_PUBLISHER_EMAIL=
PROD_PUBLISHER_PASSWORD=
PROD_VIEWER_EMAIL=
PROD_VIEWER_PASSWORD=

NEXT_PUBLIC_BASE_URL=https://verfassungen.de
PUBLIC_BASE_URL=https://verfassungen.de

# Configure outbound mail in the administrator settings after startup.

# Leave blank. ProductionIdentityGuard rejects a seeded service token.
IDENTITY_SEED_SERVICE_TOKEN=
AUDIT_API_BEARER=
EDITOR_SERVICE_TOKEN=

# Required transport prerequisites. Use external-proxy when Coolify/proxy owns TLS.
TLS_MODE=managed-acme
CADDY_BIND_ADDRESS=0.0.0.0
CADDY_PORT=80
CADDY_HTTPS_PORT=443
# Required only with TLS_MODE=external-proxy: space-separated trusted proxy CIDRs.
TLS_TRUSTED_PROXIES=

# OPTIONAL at deployment: configure these later in setup/admin settings.
# Nonblank values override saved settings and are marked deployment-managed.
SITE_LANGUAGES=
SITE_DEFAULT_LANGUAGE=
SITE_REGISTRATION_ENABLED=
SMTP_ENABLED=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
SMTP_SSL=
# OPTIONAL at deployment, REQUIRED before completing first setup.
# Actual details must be reviewed and published; environment values prefill drafts.
IMPRINT_NAME=
IMPRINT_STREET_ADDRESS=
IMPRINT_POSTAL_CODE=
IMPRINT_CITY=
IMPRINT_COUNTRY=
IMPRINT_EMAIL=
