PROFILE=testing
CADDY_EXPOSE_API_DOCS=true
TEST_ADMIN_EMAIL=test-admin@example.local
TEST_ADMIN_PASSWORD=change-me
TEST_EDITOR_EMAIL=test-editor@example.local
TEST_EDITOR_PASSWORD=change-me
TEST_REVIEWER_EMAIL=test-reviewer@example.local
TEST_REVIEWER_PASSWORD=change-me
TEST_PUBLISHER_EMAIL=test-publisher@example.local
TEST_PUBLISHER_PASSWORD=change-me
TEST_VIEWER_EMAIL=test-viewer@example.local
TEST_VIEWER_PASSWORD=change-me
IDENTITY_SEED_MODE=create-only
IDENTITY_SESSION_IDLE=15m
IDENTITY_SESSION_ABSOLUTE=8h
IDENTITY_SEED_TOTP_SECRET=CAATLASMFASEED22
IDENTITY_MFA_ENCRYPTION_KEY=testing-mfa-dev-key
AUDIT_RUNTIME_PASSWORD=testing-audit-runtime-password
SESSION_COOKIE_SECURE=false
NEXT_PUBLIC_BASE_URL=http://localhost
PUBLIC_BASE_URL=http://localhost

# Configure outbound mail in the administrator settings after startup.
IDENTITY_SEED_SERVICE_TOKEN=testing-service-token-change-me
AUDIT_API_BEARER=testing-service-token-change-me
EDITOR_SERVICE_TOKEN=testing-service-token-change-me

# Local transport exception; production rejects this mode.
TLS_MODE=local-http
CADDY_BIND_ADDRESS=127.0.0.1
CADDY_HTTPS_PORT=443

# Explicit development fixture completion; forbidden in production.
SETUP_FIXTURE_COMPLETE=true

# OPTIONAL at deployment: configure these later in setup/admin settings.
# Nonblank values override saved settings and are marked deployment-managed.
SITE_LANGUAGES=
SITE_DEFAULT_LANGUAGE=
SITE_REGISTRATION_ENABLED=
SMTP_ENABLED=
SMTP_FROM=
SMTP_FROM_NAME=
SMTP_PUBLIC_BASE_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=
SMTP_STARTTLS=
SMTP_SSL=
# OPTIONAL at deployment, REQUIRED before completing first setup.
# Actual details must be reviewed and published; environment values prefill drafts.
IMPRINT_NAME=
IMPRINT_STREET_ADDRESS=
IMPRINT_POSTAL_CODE=
IMPRINT_CITY=
IMPRINT_COUNTRY=
IMPRINT_EMAIL=
