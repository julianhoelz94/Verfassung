PROFILE=testing
CADDY_EXPOSE_API_DOCS=false
TEST_ADMIN_EMAIL=test-admin@example.local
TEST_ADMIN_PASSWORD=change-me
TEST_EDITOR_EMAIL=test-editor@example.local
TEST_EDITOR_PASSWORD=change-me
TEST_REVIEWER_EMAIL=test-reviewer@example.local
TEST_REVIEWER_PASSWORD=change-me
TEST_PUBLISHER_EMAIL=test-publisher@example.local
TEST_PUBLISHER_PASSWORD=change-me
TEST_VIEWER_EMAIL=test-viewer@example.local
TEST_VIEWER_PASSWORD=change-me
IDENTITY_SEED_MODE=create-only
IDENTITY_SESSION_IDLE=15m
IDENTITY_SESSION_ABSOLUTE=8h
IDENTITY_SEED_TOTP_SECRET=CAATLASMFASEED22
IDENTITY_MFA_ENCRYPTION_KEY=testing-mfa-dev-key
SESSION_COOKIE_SECURE=true
NEXT_PUBLIC_BASE_URL=https://tst.verfassungen.de
PUBLIC_BASE_URL=https://tst.verfassungen.de

# Optional. When SMTP_HOST and IDENTITY_MAIL_FROM are set, identity emails
# invite and reset links. Otherwise tokens are logged (log-reset-token).
IDENTITY_MAIL_ENABLED=true
IDENTITY_MAIL_FROM=
IDENTITY_MAIL_FROM_NAME=Constitution Atlas
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false
IDENTITY_SEED_SERVICE_TOKEN=testing-service-token-change-me
AUDIT_API_BEARER=testing-service-token-change-me
EDITOR_SERVICE_TOKEN=testing-service-token-change-me
