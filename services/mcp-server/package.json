{
  "name": "constitution-atlas-mcp-server",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "npm run build && node --test dist/*.test.js",
    "load:scenario": "npm run build && node dist/load-scenario.js",
    "test:coverage": "npm run build && c8 --all --src=dist --include=\"dist/**/*.js\" --exclude=\"dist/**/*.test.js\" --reporter=json --reporter=html node --test dist/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.1",
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2",
    "c8": "10.1.3"
  }
}
